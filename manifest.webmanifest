{
  "name": "100 Projects",
  "short_name": "100",
  "description": "A collection of 100+ modern creative frontend projects including UI components, animations, effects, widgets, and more.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "lang": "en",
  "dir": "auto",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#1e1e1e",
  "theme_color": "#f44234",
  "categories": ["productivity", "developer", "education", "utilities"],

  "launch_handler": {
    "client_mode": "navigate-existing"
  },

  "client_mode": "auto",

  "handle_links": "preferred",

  "capture_links": "existing-client-navigate",

  "prefer_related_applications": false,

  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "./?target=%s"
    }
  ],

  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "any",
      "type": "image/x-icon"
    },
    {
      "src": "./src/16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "./src/32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "./src/48.png",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "./src/64.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "./src/144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./src/144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./src/192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./src/192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./src/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./src/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "screenshots": [
    {
      "src": "./src/social-.png",
      "form_factor": "wide",
      "sizes": "2560x1440",
      "type": "image/png",
      "description": "ScreenShot Of Site's Upper Part."
    },
    {
      "src": "./src/social_.png",
      "sizes": "720x1600",
      "type": "image/png",
      "description": "ScreenShot Of Site's Upper Part."
    }
  ]
}
